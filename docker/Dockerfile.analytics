FROM node:22-bookworm-slim AS base
RUN corepack enable && corepack prepare pnpm@9.15.0 --activate
WORKDIR /app
COPY package.json pnpm-workspace.yaml pnpm-lock.yaml* .npmrc turbo.json ./
COPY apps/analytics/package.json apps/analytics/
COPY packages/config/package.json packages/config/
RUN pnpm install --filter @wsc/analytics...
COPY apps/analytics apps/analytics
COPY packages/config packages/config
RUN pnpm --filter @wsc/config build && pnpm --filter @wsc/analytics build
WORKDIR /app/apps/analytics
CMD ["node", "dist/main.js"]
